# ローカルビルド用 npm 設定ファイル
# Nexus npm プロキシリポジトリ経由で依存関係を取得する
# CI では .npmrc を動的生成するため、このファイルは CI では使用しない
#
# registry URL: http://nexus.local:8081/repository/npm-group/
# 認証: admin:password を Base64 エンコード
#   $ echo -n "admin:password" | base64
#   YWRtaW46cGFzc3dvcmQ=

registry=http://nexus.local:8081/repository/npm-group/
//nexus.local:8081/repository/npm-group/:_auth=YWRtaW46cGFzc3dvcmQ=
always-auth=true
